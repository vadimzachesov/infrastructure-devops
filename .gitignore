# ============================================
# Terraform
# ============================================
# Локальные директории плагинов провайдеров и модулей
**/.terraform/*
.terraform/

# Файлы состояния (содержат открытые секреты и метаданные ресурсов)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Файлы планов выполнения
*.tfplan
*.tfplan.*

# Переменные окружения (исключаем боевые, разрешаем коммитить шаблон-пример)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Переопределения конфигурации и логи аварий
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
.terraformrc
terraform.rc

# ============================================
# Ansible
# ============================================
*.retry
**/.vault_pass
.vault_pass

# ============================================
# Приватные ключи и секреты
# ============================================
id_rsa
id_rsa*
id_ed25519
id_ed25519*
!*.pub
*.pem
*.key
*.env
.env

# ============================================
# IDE и ОС
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
